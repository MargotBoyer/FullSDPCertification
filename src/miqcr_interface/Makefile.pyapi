# Makefile.pyapi — compile libmiqcr_pyapi.so (shared library pour ctypes Python)
#
# Usage (depuis src/miqcr_interface/) :
#   make -f Makefile.pyapi
#
# Les sources MIQCR minimaux nécessaires au chemin SDP sont recompilés ici
# avec -fPIC (les .o du répertoire MIQCR original n'ont pas -fPIC).
# Un stub stubs/mosek.h est utilisé pour solver_sdp_mixed.c (Mosek n'est pas
# installé ; la vraie fonction est interceptée par --wrap au runtime).

MIQCRDIR    = ../../Miqcr-1.0_triang_sbb_gurobiter_QCP5/src
CBDIR       = $(MIQCRDIR)/../ConicBundle
CSDPDIR     = $(MIQCRDIR)/../Csdp
LIB64DIR    = /usr/lib64
STUBSDIR    = stubs

CC     = gcc
LD     = g++
CFLAGS = -g -m64 -fPIC -D_GLIBC_DEBUG -DNOSHORTS -DHAVE_CPLEX
TARGET = libmiqcr_pyapi.so

# Minimal set of MIQCR sources recompiled here with -fPIC.
# Only the SDP phase call chain: solver_sdp_mixed, solver_sdp, utilities,
# quad_prog, liste, quicksort, parameters.
# Files using CPLEX/Gurobi/IPOPT are excluded (their symbols are never
# called at runtime; --unresolved-symbols=ignore-all handles any dangling refs).
MIQCR_PIC_SRCS = \
    utilities \
    liste \
    quicksort \
    quad_prog \
    parameters \
    solver_sdp \
    solver_sdp_mixed

MIQCR_PIC_OBJS = $(patsubst %, pic/%.o, $(MIQCR_PIC_SRCS))

INCLUDES = \
    -I$(MIQCRDIR) \
    -I$(CBDIR)/include \
    -I$(CSDPDIR)/include \
    -I$(STUBSDIR)

# Only link libraries available on this system.
# Mosek, CPLEX, IPOPT, Gurobi are absent; --unresolved-symbols=ignore-all
# suppresses linker errors for their symbols (never called at runtime because
# --wrap=run_sdp_solver_mixed_mosek intercepts all Mosek code paths).
LIBS = \
    -L$(CBDIR)/lib -lcb \
    -L$(CSDPDIR)/lib -lsdp \
    -L$(LIB64DIR) -l:liblapack.so.3 -l:libblas.so.3 -l:libgfortran.so.5 \
    -lm -ldl -lpthread -lz -lgomp

LDFLAGS_EXTRA = \
    -Wl,--wrap=run_sdp_solver_mixed_mosek \
    -Wl,--allow-multiple-definition \
    -Wl,--unresolved-symbols=ignore-all

all: $(TARGET)

$(TARGET): miqcr_pyapi.o $(MIQCR_PIC_OBJS)
	$(LD) -shared -fPIC $(LDFLAGS_EXTRA) -o $@ $^ $(LIBS)
	@echo ">>> $(TARGET) compilée avec succès."

miqcr_pyapi.o: miqcr_pyapi.c
	$(CC) $(CFLAGS) $(INCLUDES) -c miqcr_pyapi.c -o miqcr_pyapi.o

pic/%.o: $(MIQCRDIR)/%.c | pic
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

pic:
	mkdir -p pic

clean:
	rm -f miqcr_pyapi.o $(TARGET)
	rm -rf pic
